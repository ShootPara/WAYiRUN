// Pure archive-to-map geometry. Never recompute the run's saved distance or pace.
const mercatorLimit = 85.05112878;
const validTime = value => Number.isSafeInteger(value) && value >= 0;
function requireValid(value) {
  if (!value) throw new Error("This run could not be verified. Its saved data is unchanged.");
}
export function prepareRoute(mode, segments, points) {
  requireValid(["INDOOR", "OUTDOOR"].includes(mode) && Array.isArray(segments) && Array.isArray(points));
  if (mode === "INDOOR") {
    requireValid(points.length === 0);
    return { parts: [], pointCount: 0, note: "Indoor run · no GPS route." };
  }
  const byId = new Map();
  let previousId = 0;
  for (const [index, segment] of segments.entries()) {
    requireValid(Number.isSafeInteger(segment.id) && segment.id > previousId &&
      ["GPS", "STEPS"].includes(segment.source) && validTime(segment.startedMonotonicMs) &&
      validTime(segment.endedMonotonicMs) && segment.endedMonotonicMs >= segment.startedMonotonicMs);
    previousId = segment.id;
    byId.set(segment.id, { ...segment, index });
  }
  const parts = [];
  let previous = null, lastRowId = 0, longitude = null, polar = false;
  for (const point of points) {
    const segment = byId.get(point.segmentId);
    requireValid(segment?.source === "GPS" && Number.isSafeInteger(point.id) && point.id > lastRowId &&
      validTime(point.monotonicMs) && point.monotonicMs >= segment.startedMonotonicMs && point.monotonicMs <= segment.endedMonotonicMs &&
      Number.isFinite(point.latitude) && Math.abs(point.latitude) <= 90 &&
      Number.isFinite(point.longitude) && Math.abs(point.longitude) <= 180 &&
      Number.isFinite(point.accuracyMeters) && point.accuracyMeters >= 0);
    requireValid(!previous || segment.index > previous.index ||
      (segment.index === previous.index && point.monotonicMs > previous.time));
    const newPart = !previous || segment.index !== previous.index || point.monotonicMs - previous.time > 10000;
    if (newPart) parts.push([]);
    // Unwrap around the date line for a local view; separate parts remain separate.
    longitude = point.longitude + (longitude === null ? 0 : 360 * Math.round((longitude - point.longitude) / 360));
    parts.at(-1).push([point.latitude, longitude]);
    polar ||= Math.abs(point.latitude) > mercatorLimit;
    previous = { index: segment.index, time: point.monotonicMs };
    lastRowId = point.id;
  }
  if (polar) return { parts: [], pointCount: points.length, note: "This route is outside the map's supported latitude range." };
  return { parts, pointCount: points.length, note: !points.length ? "No GPS route was recorded for this run." :
    points.length === 1 ? "One GPS point recorded; there is no route line to draw." :
    "Recorded GPS only. Pauses and missing GPS sections are left unconnected." };
}
