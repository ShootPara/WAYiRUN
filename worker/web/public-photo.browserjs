import {prepareRoute} from "/route.js";
import {showRouteMap} from "/map.js";
const $=id=>document.getElementById(id),base=location.pathname.replace(/\/$/,"");
const duration=ms=>{const n=Math.floor(ms/1000),h=Math.floor(n/3600);return `${h?h+":":""}${h?String(Math.floor(n/60)%60).padStart(2,"0"):Math.floor(n/60)}:${String(n%60).padStart(2,"0")}`;};
try {
 const response=await fetch(`${base}/data`,{cache:"no-store"});if(!response.ok)throw Error();
 const data=await response.json(),unit=data.settings.units==="MILES"?"mi":"km",meters=unit==="mi"?1609.344:1000;
 $("photo").src=`${base}/image`;
 $("stats").textContent=`${new Date(data.run.startedUtcMs).toLocaleString()} · ${data.settings.mode==="INDOOR"?"Indoor run":"Outdoor run"} · ${(data.run.distanceMeters/meters).toFixed(2)} ${unit} · ${duration(data.run.activeDurationMs)} · ${data.run.averagePaceMsPerUnit==null?"—":duration(data.run.averagePaceMsPerUnit)} /${unit}`;
 const geometry=prepareRoute(data.settings.mode,data.segments,data.route);
 $("location").textContent=data.route.length?`Start location: ${data.route[0].latitude.toFixed(5)}, ${data.route[0].longitude.toFixed(5)}`:"No GPS location recorded.";
 if(geometry.parts.length)await showRouteMap($("map"),$("map-status"),$("fit"),geometry,()=>true);else {$("map").hidden=true;$("fit").hidden=true;$("map-status").textContent=geometry.note;}
 for(const split of data.splits){const p=document.createElement("p");p.textContent=`${split.partial?"Partial":`Split ${split.number}`} · ${(split.meters/meters).toFixed(2)} ${unit} · ${duration(split.durationMs)}`;$("splits").append(p);}
 const goal=data.settings.goal;
 $("settings").textContent=[`Units: ${unit==="mi"?"Miles":"Kilometers"}`,`Countdown: ${data.settings.countdownSeconds??0} seconds`,
   `Goal: ${goal?.type?.endsWith("Distance")?`${(goal.meters/meters).toFixed(2)} ${unit}`:goal?.type?.endsWith("Time")?duration(goal.durationMs):"None"}`,
   `Stride: ${data.settings.strideLengthMeters==null?"Not set":`${data.settings.strideLengthMeters} meters`}`].join("\n");
}catch{$("error").textContent="This shared run is unavailable.";}
